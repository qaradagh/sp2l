//@version=5
// SP2L (Spike - 2 Leg - Level) indicator v3, after Mohammad Ali Poursamadi.
// Mirrors the Python implementation in sp2l/strategy.py + backtest.py.
//
// Features:
//   - live entry / SL / partial-TP / final-TP lines while a trade is open
//   - partial take-profit, breakeven (risk-free) and ATR trailing stop
//   - risk/reward zones (position-tool style), customizable lines/boxes
//   - setup fate labels, outcome labels in R, daily P&L dashboard
//   - allow-concurrent: take every setup even while already in a trade
//   - entry order type: Market (breakout) or Limit (rest at B, may not fill)
indicator("SP2L Poursamadi [Indicator]", "SP2L", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ---------------------------------------------------------------- inputs
grpDet = "Spike detection"
minSpikeBars  = input.int(3,     "Minimum spike bars",   minval = 2, group = grpDet)
minBodyRatio  = input.float(0.5, "Min body/range ratio", minval = 0.1, maxval = 1.0, step = 0.05, group = grpDet)
dojiTolerance = input.int(1,     "Doji tolerance",       minval = 0, group = grpDet)
maxDojiRatio  = input.float(0.25,"Max doji body ratio",  minval = 0.0, maxval = 0.5, step = 0.05, group = grpDet)
requireGap    = input.bool(true, "Require P-Gap (FVG) inside spike", group = grpDet)
powerMult     = input.float(1.5, "Movement power (x ATR, 0 = off)", minval = 0.0, step = 0.1, group = grpDet)
atrLen        = input.int(14,    "ATR length", minval = 1, group = grpDet)

grpSet = "Setup lifecycle"
maxRetrace  = input.float(1.0, "Max pullback retrace (x spike)", minval = 0.1, step = 0.1, group = grpSet)
maxWaitBars = input.int(20,    "Max bars to wait after spike", minval = 1, group = grpSet)
rrFinal     = input.float(1.0, "Final target (R:R)", minval = 0.1, step = 0.1, group = grpSet)
slBufferPct = input.float(0.0, "SL buffer (fraction of spike)", minval = 0.0, maxval = 0.5, step = 0.05, group = grpSet)
useSession  = input.bool(false, "Session filter", group = grpSet)
sess        = input.session("1330-2000", "Session (exchange tz)", group = grpSet)

grpEntry = "Entries & concurrency"
allowConcurrent = input.bool(false, "Take all trades (don't skip while in a trade)", group = grpEntry)
entryMode       = input.string("Market", "Entry order type", options = ["Market", "Limit"], group = grpEntry)
limitWaitBars   = input.int(10, "Limit: bars to wait for a fill", minval = 1, group = grpEntry)

grpMgmt = "Trade management"
usePartial = input.bool(false, "Partial take-profit", group = grpMgmt)
partialRR  = input.float(1.0,  "Partial level (R)", minval = 0.1, step = 0.1, group = grpMgmt)
partialPct = input.float(50.0, "Partial size (%)", minval = 1.0, maxval = 99.0, step = 5.0, group = grpMgmt)
beMode     = input.string("Off", "Breakeven (risk-free)", options = ["Off", "At RR trigger", "After partial"], group = grpMgmt)
beTrigRR   = input.float(1.0,  "BE trigger (R)", minval = 0.1, step = 0.1, group = grpMgmt)
beOffsetR  = input.float(0.0,  "BE offset (R locked)", minval = -1.0, maxval = 1.0, step = 0.05, group = grpMgmt)

grpFlt = "Filters & risk guards"
trailMult    = input.float(0.0, "ATR trailing stop (x ATR, 0 = off)", minval = 0.0, step = 0.5, group = grpFlt)
costR        = input.float(0.0, "Cost per trade (R)", minval = 0.0, step = 0.01, group = grpFlt)
maxTradesDay = input.int(0,     "Max trades per day (0 = off)", minval = 0, group = grpFlt)
maxLossDayR  = input.float(0.0, "Max daily loss (R, 0 = off)", minval = 0.0, step = 0.5, group = grpFlt)

grpVis = "Display"
showSpike  = input.bool(true, "Highlight spike zone", group = grpVis)
showFvg    = input.bool(true, "Show P-Gap (FVG) boxes", group = grpVis)
showLevels = input.bool(true, "Show live A/B levels", group = grpVis)
showFate   = input.bool(true, "Label cancelled/expired/skipped setups", group = grpVis)
showTable  = input.bool(true, "Show status table", group = grpVis)
bullColor  = input.color(color.teal,   "Bull", inline = "c", group = grpVis)
bearColor  = input.color(color.maroon, "Bear", inline = "c", group = grpVis)

grpLine = "Trade lines"
lineStyleInp     = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = grpLine)
lineWidthInp     = input.int(2, "Line width", minval = 1, maxval = 5, group = grpLine)
lineExtendBars   = input.int(0, "Extend lines right (bars)", minval = 0, maxval = 100, group = grpLine)
showSignalPrices = input.bool(true, "Show E/SL/TP prices in the signal label", group = grpLine)
entryColInp      = input.color(color.orange, "Entry", inline = "lc", group = grpLine)
slColInp         = input.color(color.red,    "Stop", inline = "lc", group = grpLine)
tpColInp         = input.color(color.green,  "Target", inline = "lc", group = grpLine)

grpRR = "Risk / reward zones"
showRR      = input.bool(true, "Show risk/reward zones (position-tool style)", group = grpRR)
riskColor   = input.color(color.new(color.red, 82),   "Risk (SL) zone", inline = "rr", group = grpRR)
rewardColor = input.color(color.new(color.green, 82), "Reward (TP) zone", inline = "rr", group = grpRR)
showRRText  = input.bool(true, "Show R:R ratio label", group = grpRR)

grpBox = "Box transparency"
spikeBg     = input.int(88, "Spike fill", minval = 0, maxval = 100, inline = "sp", group = grpBox)
spikeBorder = input.int(60, "border", minval = 0, maxval = 100, inline = "sp", group = grpBox)
fvgBg       = input.int(80, "FVG fill", minval = 0, maxval = 100, inline = "fv", group = grpBox)
fvgBorder   = input.int(55, "border", minval = 0, maxval = 100, inline = "fv", group = grpBox)

grpHist = "History"
useHistory  = input.bool(false, "Limit chart drawings to recent days", group = grpHist)
historyDays = input.int(10, "Days of history to draw", minval = 1, maxval = 120, group = grpHist)

grpDash = "Dashboard"
showDash = input.bool(true, "Show dashboard", group = grpDash)
dashDays = input.int(5,  "Days shown", minval = 1, maxval = 15, group = grpDash)
dashList = input.int(8,  "Recent trades shown", minval = 1, maxval = 20, group = grpDash)

// ---------------------------------------------------------------- helpers
rng        = high - low
bodyRatio  = rng > 0 ? math.abs(close - open) / rng : 0.0
isDoji     = bodyRatio <= maxDojiRatio
strongBull = close > open and bodyRatio >= minBodyRatio and not isDoji
strongBear = close < open and bodyRatio >= minBodyRatio and not isDoji
atrVal     = ta.atr(atrLen)
inSession  = not useSession or not na(time(timeframe.period, sess))

sbN = strongBull ? 1 : 0
ssN = strongBear ? 1 : 0
djN = isDoji ? 1 : 0

lineStyle = lineStyleInp == "Dashed" ? line.style_dashed : lineStyleInp == "Dotted" ? line.style_dotted : line.style_solid
msPerDay  = 24 * 60 * 60 * 1000
// last_bar_time follows the bar-replay cursor, so this gate works in replay too.
drawOK    = not useHistory or time >= last_bar_time - historyDays * msPerDay
remPct    = 1.0 - partialPct / 100.0

pad2(int v) =>
    v < 10 ? "0" + str.tostring(v) : str.tostring(v)

fmtR(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.00") + "R"

countRun(simple bool bullish) =>
    int run = 0
    int dojis = 0
    int strong = 0
    bool ok = true
    for i = 0 to 300
        if not ok
            break
        bool s = bullish ? nz(sbN[i]) == 1 : nz(ssN[i]) == 1
        bool d = nz(djN[i]) == 1
        if s
            strong += 1
            run += 1
        else if d and dojis < dojiTolerance
            dojis += 1
            run += 1
        else
            ok := false
    [run, strong]

hasFvg(int runLen, simple bool bullish) =>
    bool found = false
    if runLen >= 2
        for k = 0 to runLen - 2
            if k + 2 <= bar_index
                if bullish and low[k] > high[k + 2]
                    found := true
                if not bullish and high[k] < low[k + 2]
                    found := true
    found

detectSpike(simple bool bullish) =>
    [run, strong] = countRun(bullish)
    bool ok = false
    float pA = na
    float pB = na
    bool lastStrong = bullish ? strongBull : strongBear
    if run >= minSpikeBars and strong >= minSpikeBars - dojiTolerance and lastStrong and run - 1 <= bar_index
        bool okGap = not requireGap or hasFvg(run, bullish)
        float move = bullish ? high - low[run - 1] : high[run - 1] - low
        bool okPow = powerMult <= 0 or na(atrVal) or move >= powerMult * atrVal
        if okGap and okPow
            ok := true
            pA := bullish ? low[run - 1] : high[run - 1]
            pB := bullish ? high : low
    [ok, pA, pB, run]

[okBull, aBull, bBull, runBull] = detectSpike(true)
[okBear, aBear, bBear, runBear] = detectSpike(false)

// ---------------------------------------------------------------- journal
var tTimes = array.new_int()
var tDirs  = array.new_int()
var tRs    = array.new_float()
var dayIds = array.new_int()
var dayRs  = array.new_float()
var dayNs  = array.new_int()
var dayWs  = array.new_int()

logTrade(int t, int d, float r) =>
    array.push(tTimes, t)
    array.push(tDirs, d)
    array.push(tRs, r)
    if array.size(tTimes) > 150
        array.shift(tTimes)
        array.shift(tDirs)
        array.shift(tRs)
    int dayid = year(t) * 10000 + month(t) * 100 + dayofmonth(t)
    int n = array.size(dayIds)
    bool sameDay = n > 0
    if sameDay
        sameDay := array.get(dayIds, n - 1) == dayid  // Pine `and` is not short-circuit
    if sameDay
        array.set(dayRs, n - 1, array.get(dayRs, n - 1) + r)
        array.set(dayNs, n - 1, array.get(dayNs, n - 1) + 1)
        array.set(dayWs, n - 1, array.get(dayWs, n - 1) + (r > 0 ? 1 : 0))
    else
        array.push(dayIds, dayid)
        array.push(dayRs, r)
        array.push(dayNs, 1)
        array.push(dayWs, r > 0 ? 1 : 0)
        if array.size(dayIds) > 60
            array.shift(dayIds)
            array.shift(dayRs)
            array.shift(dayNs)
            array.shift(dayWs)
    0  // constant tail so the function has one consistent (ignored) return type

todayStats() =>
    int dayid = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
    int n = 0
    float r = 0.0
    int sz = array.size(dayIds)
    if sz > 0
        if array.get(dayIds, sz - 1) == dayid
            n := array.get(dayNs, sz - 1)
            r := array.get(dayRs, sz - 1)
    [n, r]

// ---------------------------------------------------------------- types
type Trade
    int   dir
    float entry
    float initSL
    float sl
    float tp1
    float tp2
    int   entryBar
    bool  partial = false
    bool  be      = false
    bool  trail   = false
    float realR   = 0.0
    line  eLn     = na
    line  sLn     = na
    line  t1Ln    = na
    line  t2Ln    = na
    box   riskBox = na
    box   rewBox  = na
    label rrLbl   = na

type Pending
    int   dir
    float entry
    float initSL
    int   idx

// Create a Trade, draw its objects (respecting drawOK/showRR) and return it.
makeTrade(int d, float en, float isl) =>
    float Ru = math.abs(en - isl)
    Trade t = Trade.new(dir = d, entry = en, initSL = isl, sl = isl,
         tp1 = en + (d == 1 ? 1 : -1) * partialRR * Ru,
         tp2 = en + (d == 1 ? 1 : -1) * rrFinal * Ru,
         entryBar = bar_index)
    if drawOK
        int x2 = bar_index + 1 + lineExtendBars
        color c = d == 1 ? bullColor : bearColor
        t.eLn  := line.new(bar_index, en, x2, en, color = entryColInp, width = lineWidthInp, style = lineStyle)
        t.sLn  := line.new(bar_index, isl, x2, isl, color = slColInp, width = lineWidthInp, style = lineStyle)
        t.t2Ln := line.new(bar_index, t.tp2, x2, t.tp2, color = tpColInp, width = lineWidthInp, style = lineStyle)
        if usePartial
            t.t1Ln := line.new(bar_index, t.tp1, x2, t.tp1, color = color.new(tpColInp, 40), width = 1, style = line.style_dashed)
        if showRR
            t.riskBox := box.new(bar_index, math.max(en, isl), x2, math.min(en, isl), bgcolor = riskColor, border_color = color.new(slColInp, 75), border_width = 1)
            t.rewBox  := box.new(bar_index, math.max(en, t.tp2), x2, math.min(en, t.tp2), bgcolor = rewardColor, border_color = color.new(tpColInp, 75), border_width = 1)
            if showRRText and Ru > 0
                t.rrLbl := label.new(bar_index, t.tp2, "R:R 1:" + str.tostring(math.abs(t.tp2 - en) / Ru, "0.0"), style = label.style_label_left, color = color.new(tpColInp, 25), textcolor = color.white, size = size.tiny)
        string txt = (d == 1 ? "SP2L ▲ LONG" : "SP2L ▼ SHORT")
             + (showSignalPrices ? "\nE  " + str.tostring(en, format.mintick)
                 + "\nSL " + str.tostring(isl, format.mintick)
                 + (usePartial ? "\nTP1 " + str.tostring(t.tp1, format.mintick) : "")
                 + "\nTP " + str.tostring(t.tp2, format.mintick) : "")
        label.new(bar_index, d == 1 ? low : high, txt,
             style = d == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(c, 15), textcolor = color.white, size = size.small)
    t

fateLabel(float y, string txt) =>
    if showFate and drawOK
        label.new(bar_index, y, txt, style = label.style_label_left,
             color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)
    0

// ---------------------------------------------------------------- state
var array<Trade>   trades = array.new<Trade>()
var array<Pending> pend   = array.new<Pending>()

// Setup state (only one pending setup at a time).
var int   dir       = 0      // 0 idle, 1 long setup, -1 short setup
var float pointA    = na
var float pointB    = na
var int   spikeEnd  = na
var bool  inPull    = false
var int   pullStart = na
var line  lnA = na
var line  lnB = na
var box   spikeBox = na

// Daily counters for the risk guard.
var int curDay    = na
var int dayOpened = 0
int today = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
if today != curDay
    curDay := today
    dayOpened := 0

bool longFire      = false
bool shortFire     = false
bool closedThisBar = false
bool partialThisBar = false
float sigB = na
float sigA = na

[todayN, todayR] = todayStats()
bool guardBlocked = (maxTradesDay > 0 and dayOpened >= maxTradesDay) or (maxLossDayR > 0 and todayR <= -maxLossDayR)

// ------------------------------------------- 1) manage every open trade
int ti = array.size(trades) - 1
while ti >= 0
    Trade t = array.get(trades, ti)
    float Ru = math.abs(t.entry - t.initSL)
    bool closeNow = false
    float closePx = na
    float closeR  = na
    string closeTag = ""
    bool slHit = t.dir == 1 ? low <= t.sl : high >= t.sl
    if slHit
        float rem = t.partial ? remPct : 1.0
        float slR = (t.dir == 1 ? t.sl - t.entry : t.entry - t.sl) / Ru
        closeNow := true
        closePx  := t.sl
        closeR   := t.realR + slR * rem - costR
        closeTag := slR >= 0 ? (t.trail ? "TRL" : "BE") : "SL"
    else
        if usePartial and not t.partial
            bool p1 = t.dir == 1 ? high >= t.tp1 : low <= t.tp1
            if p1
                t.realR := t.realR + partialRR * partialPct / 100.0
                t.partial := true
                partialThisBar := true
                if beMode == "After partial" and not t.be
                    float ns = t.entry + (t.dir == 1 ? 1 : -1) * beOffsetR * Ru
                    t.sl := t.dir == 1 ? math.max(t.sl, ns) : math.min(t.sl, ns)
                    t.be := true
                if not na(t.t1Ln)
                    line.set_color(t.t1Ln, color.new(color.green, 70))
                    line.set_x2(t.t1Ln, bar_index)
        if beMode == "At RR trigger" and not t.be
            bool trg = t.dir == 1 ? high >= t.entry + beTrigRR * Ru : low <= t.entry - beTrigRR * Ru
            if trg
                float ns = t.entry + (t.dir == 1 ? 1 : -1) * beOffsetR * Ru
                t.sl := t.dir == 1 ? math.max(t.sl, ns) : math.min(t.sl, ns)
                t.be := true
        if trailMult > 0 and not na(atrVal)
            float tc = t.dir == 1 ? close - trailMult * atrVal : close + trailMult * atrVal
            float ns2 = t.dir == 1 ? math.max(t.sl, tc) : math.min(t.sl, tc)
            if ns2 != t.sl
                t.sl := ns2
                t.trail := true
        bool tpHit = t.dir == 1 ? high >= t.tp2 : low <= t.tp2
        if tpHit
            float rem = t.partial ? remPct : 1.0
            closeNow := true
            closePx  := t.tp2
            closeR   := t.realR + rrFinal * rem - costR
            closeTag := "TP"
    if closeNow
        if not na(t.eLn)
            line.set_x2(t.eLn, bar_index)
            line.set_x2(t.sLn, bar_index)
            line.set_x2(t.t2Ln, bar_index)
            if not na(t.t1Ln)
                line.set_x2(t.t1Ln, math.min(line.get_x2(t.t1Ln), bar_index))
        if not na(t.riskBox)
            box.set_right(t.riskBox, bar_index)
            box.set_right(t.rewBox, bar_index)
        if drawOK
            color oc = closeTag == "TP" ? (t.dir == 1 ? bullColor : bearColor) : closeTag == "SL" ? color.red : color.blue
            label.new(bar_index, closePx, closeTag + " " + fmtR(closeR),
                 style = t.dir == 1 ? label.style_label_down : label.style_label_up,
                 color = color.new(oc, 20), textcolor = color.white, size = size.small)
        logTrade(time, t.dir, closeR)
        closedThisBar := true
        array.remove(trades, ti)
    else
        if not na(t.sLn)
            line.set_y1(t.sLn, t.sl)
            line.set_y2(t.sLn, t.sl)
            if t.be or t.trail
                line.set_color(t.sLn, color.blue)
        int xr = bar_index + lineExtendBars
        if not na(t.eLn)
            line.set_x2(t.eLn, xr)
            line.set_x2(t.sLn, xr)
            line.set_x2(t.t2Ln, xr)
            if not na(t.t1Ln) and not t.partial
                line.set_x2(t.t1Ln, xr)
        if not na(t.riskBox)
            box.set_right(t.riskBox, xr)
            box.set_right(t.rewBox, xr)
    ti -= 1

// ------------------------------------------- 2) fill / cancel resting limits
int pi = array.size(pend) - 1
while pi >= 0
    Pending p = array.get(pend, pi)
    bool filled = p.dir == 1 ? low <= p.entry : high >= p.entry
    if filled
        array.remove(pend, pi)
        Trade nt = makeTrade(p.dir, p.entry, p.initSL)
        array.push(trades, nt)
        dayOpened += 1
    else if bar_index - p.idx >= limitWaitBars
        array.remove(pend, pi)
        fateLabel(p.entry, "◌ Not activated")
    pi -= 1

// ------------------------------------------- 3) setup lifecycle
if dir != 0
    float spLen = math.abs(pointB - pointA)
    bool invalid = dir == 1 ? low <= pointB - spLen * maxRetrace : high >= pointB + spLen * maxRetrace
    bool expired = bar_index - spikeEnd > maxWaitBars
    if invalid or expired
        if not na(lnA)
            line.set_color(lnA, color.new(color.gray, 70))
            line.set_color(lnB, color.new(color.gray, 70))
        fateLabel(pointB, invalid ? "✖ Cancelled" : "✖ Expired")
        dir := 0
        inPull := false
        pullStart := na
        lnA := na
        lnB := na
        spikeBox := na

if dir != 0 and not inPull and bar_index == spikeEnd + 1
    bool extended = dir == 1 ? strongBull : strongBear
    if extended
        spikeEnd := bar_index
        pointB := dir == 1 ? high : low
        if not na(lnB)
            line.set_y1(lnB, pointB)
            line.set_y2(lnB, pointB)
        if not na(spikeBox)
            box.set_right(spikeBox, bar_index)
            if dir == 1
                box.set_top(spikeBox, math.max(box.get_top(spikeBox), pointB))
            else
                box.set_bottom(spikeBox, math.min(box.get_bottom(spikeBox), pointB))

if dir != 0 and not inPull and bar_index > spikeEnd
    bool pb = dir == 1 ? (low < low[1] or close < open) : (high > high[1] or close > open)
    if pb
        inPull := true
        pullStart := bar_index

if dir != 0 and inPull and bar_index > pullStart
    bool broke = dir == 1 ? high > pointB : low < pointB
    if broke
        sigB := pointB
        sigA := pointA
        if dir == 1
            longFire := true
        else
            shortFire := true
        if not na(lnA)
            line.set_x2(lnA, bar_index)
            line.set_x2(lnB, bar_index)
        dir := 0
        inPull := false
        pullStart := na
        lnA := na
        lnB := na
        spikeBox := na

// ------------------------------------------- 4) adopt a fresh spike when idle
if dir == 0 and (okBull or okBear)
    dir := okBull ? 1 : -1
    pointA := okBull ? aBull : aBear
    pointB := okBull ? bBull : bBear
    int runSel = okBull ? runBull : runBear
    spikeEnd := bar_index
    int startIdx = bar_index - runSel + 1
    if showLevels and drawOK
        lnB := line.new(bar_index, pointB, bar_index + 1, pointB, color = color.orange, width = 2)
        lnA := line.new(bar_index, pointA, bar_index + 1, pointA, color = color.new(color.red, 30), width = 1, style = line.style_dashed)
    if showSpike and drawOK
        float spHi = high
        float spLo = low
        for k = 0 to runSel - 1
            spHi := math.max(spHi, nz(high[k], spHi))
            spLo := math.min(spLo, nz(low[k], spLo))
        color zc = dir == 1 ? bullColor : bearColor
        spikeBox := box.new(startIdx, spHi, bar_index, spLo,
             bgcolor = color.new(zc, spikeBg), border_color = color.new(zc, spikeBorder),
             text = "SPIKE", text_size = size.tiny, text_color = color.new(zc, 40),
             text_halign = text.align_center, text_valign = dir == 1 ? text.align_top : text.align_bottom)
    if showFvg and drawOK
        color gc = dir == 1 ? bullColor : bearColor
        for k = 0 to runSel - 2
            if k + 2 <= bar_index
                if dir == 1 and low[k] > high[k + 2]
                    box.new(bar_index - k - 2, low[k], bar_index - k, high[k + 2], bgcolor = color.new(gc, fvgBg), border_color = color.new(gc, fvgBorder))
                if dir == -1 and high[k] < low[k + 2]
                    box.new(bar_index - k - 2, low[k + 2], bar_index - k, high[k], bgcolor = color.new(gc, fvgBg), border_color = color.new(gc, fvgBorder))

if dir != 0 and not na(lnA)
    line.set_x2(lnA, bar_index)
    line.set_x2(lnB, bar_index)

// ------------------------------------------- 5) act on a fresh breakout signal
if longFire or shortFire
    int d = longFire ? 1 : -1
    float buffer = math.abs(sigB - sigA) * slBufferPct
    float isl = d == 1 ? sigA - buffer : sigA + buffer
    bool busy = array.size(trades) > 0 or array.size(pend) > 0
    if not inSession
        fateLabel(sigB, "◌ Off-session")
    else if busy and not allowConcurrent
        fateLabel(sigB, "◌ Skipped (in trade)")
    else if guardBlocked
        fateLabel(sigB, "◌ Daily limit")
    else if entryMode == "Limit"
        Pending p = Pending.new(dir = d, entry = sigB, initSL = isl, idx = bar_index)
        array.push(pend, p)
    else
        float en = d == 1 ? math.max(sigB, open) : math.min(sigB, open)
        Trade nt = makeTrade(d, en, isl)
        array.push(trades, nt)
        dayOpened += 1

plotshape(longFire,  "Long signal",  shape.triangleup,   location.belowbar, color = bullColor, size = size.tiny)
plotshape(shortFire, "Short signal", shape.triangledown, location.abovebar, color = bearColor, size = size.tiny)

// ---------------------------------------------------------------- status table
var table tbl = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 35), border_width = 1, border_color = color.new(color.gray, 60))
if showTable and barstate.islast
    string stTxt = dir == 0 ? "IDLE" : inPull ? "PULLBACK" : "SPIKE"
    color stCol = dir == 1 ? bullColor : dir == -1 ? bearColor : color.gray
    int nOpen = array.size(trades)
    int nPend = array.size(pend)
    float liveR = 0.0
    if nOpen > 0
        for i = 0 to nOpen - 1
            Trade t = array.get(trades, i)
            float Ru = math.abs(t.entry - t.initSL)
            if Ru > 0
                liveR += t.realR + (t.dir == 1 ? close - t.entry : t.entry - close) / Ru * (t.partial ? remPct : 1.0)
    string tradeTxt = nOpen == 0 and nPend == 0 ? "FLAT" : "OPEN x" + str.tostring(nOpen) + (nPend > 0 ? " +" + str.tostring(nPend) + "L" : "") + "  " + fmtR(liveR)
    table.cell(tbl, 0, 0, "SP2L",  text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, stTxt,   text_color = color.white, text_size = size.small, bgcolor = color.new(stCol, 30))
    table.cell(tbl, 0, 1, "Dir",   text_color = color.silver, text_size = size.small)
    table.cell(tbl, 1, 1, dir == 1 ? "LONG" : dir == -1 ? "SHORT" : "—", text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 2, "Entry B", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 1, 2, dir != 0 ? str.tostring(pointB, format.mintick) : "—", text_color = color.orange, text_size = size.small)
    table.cell(tbl, 0, 3, "Stop A",  text_color = color.silver, text_size = size.small)
    table.cell(tbl, 1, 3, dir != 0 ? str.tostring(pointA, format.mintick) : "—", text_color = color.red, text_size = size.small)
    table.cell(tbl, 0, 4, "Trade", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 1, 4, tradeTxt, text_color = nOpen == 0 ? color.white : liveR >= 0 ? color.lime : color.red, text_size = size.small)

// ---------------------------------------------------------------- dashboard
var table dash = table.new(position.bottom_right, 3, dashDays + dashList + 3,
     bgcolor = color.new(color.black, 25), border_width = 1, border_color = color.new(color.gray, 65))
if showDash and barstate.islast
    table.clear(dash, 0, 0, 2, dashDays + dashList + 2)
    int row = 0
    table.cell(dash, 0, row, "Day",  text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, row, "N (W)", text_color = color.silver, text_size = size.small)
    table.cell(dash, 2, row, "Net R", text_color = color.silver, text_size = size.small)
    row += 1
    int nd = array.size(dayIds)
    for i = 0 to dashDays - 1
        int idx = nd - 1 - i
        if idx >= 0
            int dayid = array.get(dayIds, idx)
            float r = array.get(dayRs, idx)
            string dstr = pad2(math.floor(dayid / 100) % 100) + "-" + pad2(dayid % 100)
            table.cell(dash, 0, row, dstr, text_color = color.white, text_size = size.small)
            table.cell(dash, 1, row, str.tostring(array.get(dayNs, idx)) + " (" + str.tostring(array.get(dayWs, idx)) + "W)", text_color = color.white, text_size = size.small)
            table.cell(dash, 2, row, fmtR(r), text_color = r >= 0 ? color.lime : color.red, text_size = size.small)
            row += 1
    float totR = array.size(dayRs) > 0 ? array.sum(dayRs) : 0.0
    int totN = array.size(tRs)
    table.cell(dash, 0, row, "Σ total", text_color = color.white, text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(dash, 1, row, str.tostring(totN), text_color = color.white, text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(dash, 2, row, fmtR(totR), text_color = totR >= 0 ? color.lime : color.red, text_size = size.small, bgcolor = color.new(color.gray, 70))
    row += 1
    table.cell(dash, 0, row, "Time",  text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, row, "Dir",   text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 2, row, "R",     text_color = color.silver, text_size = size.tiny)
    row += 1
    int nt = array.size(tRs)
    for i = 0 to dashList - 1
        int idx = nt - 1 - i
        if idx >= 0
            int tt = array.get(tTimes, idx)
            float r = array.get(tRs, idx)
            int d = array.get(tDirs, idx)
            string tstr = pad2(month(tt)) + "-" + pad2(dayofmonth(tt)) + " " + pad2(hour(tt)) + ":" + pad2(minute(tt))
            table.cell(dash, 0, row, tstr, text_color = color.white, text_size = size.tiny)
            table.cell(dash, 1, row, d == 1 ? "▲" : "▼", text_color = d == 1 ? bullColor : bearColor, text_size = size.tiny)
            table.cell(dash, 2, row, fmtR(r), text_color = r >= 0 ? color.lime : color.red, text_size = size.tiny)
            row += 1

// ---------------------------------------------------------------- alerts
alertcondition(longFire,  "SP2L Long",  "SP2L: long breakout signal")
alertcondition(shortFire, "SP2L Short", "SP2L: short breakout signal")
alertcondition(longFire or shortFire, "SP2L Any signal", "SP2L: entry signal")
alertcondition(partialThisBar, "SP2L Partial filled", "SP2L: partial take-profit filled")
alertcondition(closedThisBar, "SP2L Trade closed", "SP2L: a trade closed (see chart label)")
