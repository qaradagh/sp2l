//@version=5
// SP2L (Spike - 2 Leg - Level) strategy, after Mohammad Ali Poursamadi.
// Mirrors the Python implementation in sp2l/strategy.py. When a pullback
// starts, a stop order is parked at the entry level (B) so TradingView can
// fill it intrabar at the level, like the Python backtester does. The order
// is cancelled if the setup expires or is invalidated.
strategy("SP2L Poursamadi [Strategy]", "SP2L strat", overlay = true,
     initial_capital = 10000,
     commission_type = strategy.commission.percent, commission_value = 0.0)

// ---------------------------------------------------------------- inputs
grpDet = "Spike detection"
minSpikeBars  = input.int(3,     "Minimum spike bars",   minval = 2, group = grpDet)
minBodyRatio  = input.float(0.5, "Min body/range ratio", minval = 0.1, maxval = 1.0, step = 0.05, group = grpDet)
dojiTolerance = input.int(1,     "Doji tolerance",       minval = 0, group = grpDet)
maxDojiRatio  = input.float(0.25,"Max doji body ratio",  minval = 0.0, maxval = 0.5, step = 0.05, group = grpDet)
requireGap    = input.bool(true, "Require P-Gap (FVG) inside spike", group = grpDet)
powerMult     = input.float(1.5, "Movement power (x ATR, 0 = off)", minval = 0.0, step = 0.1, group = grpDet)
atrLen        = input.int(14,    "ATR length", minval = 1, group = grpDet)

grpSet = "Setup lifecycle"
maxRetrace  = input.float(1.0, "Max pullback retrace (x spike)", minval = 0.1, step = 0.1, group = grpSet)
maxWaitBars = input.int(20,    "Max bars to wait after spike", minval = 1, group = grpSet)
rr          = input.float(1.0, "Risk : Reward", minval = 0.1, step = 0.1, group = grpSet)
slBufferPct = input.float(0.0, "SL buffer (fraction of spike)", minval = 0.0, maxval = 0.5, step = 0.05, group = grpSet)
riskPct     = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 10.0, step = 0.1, group = grpSet)
useSession  = input.bool(false, "Session filter", group = grpSet)
sess        = input.session("1330-2000", "Session (exchange tz)", group = grpSet)

// ---------------------------------------------------------------- helpers
rng        = high - low
bodyRatio  = rng > 0 ? math.abs(close - open) / rng : 0.0
isDoji     = bodyRatio <= maxDojiRatio
strongBull = close > open and bodyRatio >= minBodyRatio and not isDoji
strongBear = close < open and bodyRatio >= minBodyRatio and not isDoji
atrVal     = ta.atr(atrLen)
inSession  = not useSession or not na(time(timeframe.period, sess))

sbN = strongBull ? 1 : 0
ssN = strongBear ? 1 : 0
djN = isDoji ? 1 : 0

countRun(simple bool bullish) =>
    int run = 0
    int dojis = 0
    int strong = 0
    bool ok = true
    for i = 0 to 300
        if not ok
            break
        bool s = bullish ? nz(sbN[i]) == 1 : nz(ssN[i]) == 1
        bool d = nz(djN[i]) == 1
        if s
            strong += 1
            run += 1
        else if d and dojis < dojiTolerance
            dojis += 1
            run += 1
        else
            ok := false
    [run, strong]

hasFvg(int runLen, simple bool bullish) =>
    bool found = false
    if runLen >= 2
        for k = 0 to runLen - 2
            if k + 2 <= bar_index
                if bullish and low[k] > high[k + 2]
                    found := true
                if not bullish and high[k] < low[k + 2]
                    found := true
    found

detectSpike(simple bool bullish) =>
    [run, strong] = countRun(bullish)
    bool ok = false
    float pA = na
    float pB = na
    bool lastStrong = bullish ? strongBull : strongBear
    if run >= minSpikeBars and strong >= minSpikeBars - dojiTolerance and lastStrong and run - 1 <= bar_index
        bool okGap = not requireGap or hasFvg(run, bullish)
        float move = bullish ? high - low[run - 1] : high[run - 1] - low
        bool okPow = powerMult <= 0 or na(atrVal) or move >= powerMult * atrVal
        if okGap and okPow
            ok := true
            pA := bullish ? low[run - 1] : high[run - 1]
            pB := bullish ? high : low
    [ok, pA, pB, run]

[okBull, aBull, bBull, runBull] = detectSpike(true)
[okBear, aBear, bBear, runBear] = detectSpike(false)

// ---------------------------------------------------------------- state
var int   dir       = 0
var float pointA    = na
var float pointB    = na
var int   spikeEnd  = na
var bool  inPull    = false
var int   pullStart = na
var bool  ordered   = false   // stop order parked at B

// --- an order from this setup filled: hand over to strategy.exit
if dir != 0 and ordered and strategy.position_size != 0
    dir := 0
    inPull := false
    pullStart := na
    ordered := false

// --- expiry / invalidation
if dir != 0
    float spLen = math.abs(pointB - pointA)
    bool invalid = dir == 1 ? low <= pointB - spLen * maxRetrace : high >= pointB + spLen * maxRetrace
    if bar_index - spikeEnd > maxWaitBars or invalid
        if ordered
            strategy.cancel("SP2L L")
            strategy.cancel("SP2L S")
        dir := 0
        inPull := false
        pullStart := na
        ordered := false

// --- spike extension (contiguous strong candle only, before any pullback)
if dir != 0 and not inPull and bar_index == spikeEnd + 1
    bool extended = dir == 1 ? strongBull : strongBear
    if extended
        spikeEnd := bar_index
        pointB := dir == 1 ? high : low

// --- pullback start: park the stop order at B with SL/TP attached
if dir != 0 and not inPull and bar_index > spikeEnd
    bool pb = dir == 1 ? (low < low[1] or close < open) : (high > high[1] or close > open)
    if pb
        inPull := true
        pullStart := bar_index
        if strategy.position_size == 0 and inSession
            float spLen = math.abs(pointB - pointA)
            float buffer = spLen * slBufferPct
            if dir == 1
                float slPx = pointA - buffer
                float perUnit = pointB - slPx
                float qty = perUnit > 0 ? strategy.equity * riskPct / 100.0 / perUnit : na
                if not na(qty)
                    strategy.entry("SP2L L", strategy.long, qty = qty, stop = pointB)
                    strategy.exit("x L", "SP2L L", stop = slPx, limit = pointB + rr * perUnit)
                    ordered := true
            else
                float slPx = pointA + buffer
                float perUnit = slPx - pointB
                float qty = perUnit > 0 ? strategy.equity * riskPct / 100.0 / perUnit : na
                if not na(qty)
                    strategy.entry("SP2L S", strategy.short, qty = qty, stop = pointB)
                    strategy.exit("x S", "SP2L S", stop = slPx, limit = pointB - rr * perUnit)
                    ordered := true

// --- adopt a freshly detected spike when idle
if dir == 0 and (okBull or okBear)
    dir := okBull ? 1 : -1
    pointA := okBull ? aBull : aBear
    pointB := okBull ? bBull : bBear
    spikeEnd := bar_index
    ordered := false

// ---------------------------------------------------------------- plots
plot(dir != 0 ? pointB : na, "Entry level (B)", color = color.new(color.orange, 0), style = plot.style_linebr)
plot(dir != 0 ? pointA : na, "Stop level (A)",  color = color.new(color.red, 40),   style = plot.style_linebr)
bgcolor(dir == 1 ? color.new(color.teal, 92) : dir == -1 ? color.new(color.maroon, 92) : na)
